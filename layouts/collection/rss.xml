{{- $feed := partial "collection-feed.xml" . -}}
{{- if eq .Section "publikacje" -}}
  {{- /* Keep existing RSS subscriptions working at the former section URLs. */ -}}
  {{- range .Aliases -}}
    {{- $path := printf "%s/index.xml" (strings.TrimPrefix "/" .) -}}
    {{- with resources.FromString $path $feed -}}{{- .Publish -}}{{- end -}}
  {{- end -}}
{{- end -}}
{{- $feed | safeHTML -}}
